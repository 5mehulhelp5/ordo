<?php
/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Magento\Framework\Escaper $escaper */
/** @var \Ordo\Automation\Block\Frontend\TrackerViewModel $viewModel */
$viewModel = $block->getData('view_model');
?>
<?php if ($viewModel->isTrackingEnabled()): ?>
<script
    src="<?= $escaper->escapeUrl($block->getViewFileUrl('Ordo_Automation::js/tracker.js')) ?>"
    data-popup-enabled="<?= $viewModel->isPopupEnabled() ? '1' : '0' ?>"
    data-popup-poll-interval="<?= (int) $viewModel->getPopupPollIntervalSeconds() ?>"
    data-notification-enabled="<?= $viewModel->isNotificationEnabled() ? '1' : '0' ?>"
    data-notification-poll-interval="<?= (int) $viewModel->getNotificationPollIntervalSeconds() ?>"
    data-nps-survey-enabled="<?= $viewModel->isNpsSurveyEnabled() ? '1' : '0' ?>"
    data-nps-survey-poll-interval="<?= (int) $viewModel->getNpsSurveyPollIntervalSeconds() ?>"
    data-push-enabled="<?= $viewModel->isPushEnabled() ? '1' : '0' ?>"
    data-push-vapid-public-key="<?= $escaper->escapeHtmlAttr($viewModel->getVapidPublicKey()) ?>"
></script>
<?php endif; ?>
