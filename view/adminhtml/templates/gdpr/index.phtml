<?php if ($block->isCustomerResolved()): ?>
    <?php
    $consent = $block->getConsentStates();
    $consentTitle = __('Consent - customer #%1 (%2)', $block->getCustomerId(), $block->getCustomerEmail());
    ?>
<div class="admin__fieldset-wrapper" style="margin-top: 20px;">
    <div class="admin__fieldset-wrapper-title">
        <strong><?= $escaper->escapeHtml($consentTitle) ?></strong>
    </div>
    <div class="admin__fieldset-wrapper-content">
        <form action="<?= $escaper->escapeUrl($block->getSetConsentFormAction()) ?>" method="post">
            <?= $block->getBlockHtml('formkey') ?>
            <input type="hidden" name="customer_id" value="<?= (int) $block->getCustomerId() ?>"/>
            <input type="hidden" name="email" value="<?= $escaper->escapeHtmlAttr($block->getCustomerEmail()) ?>"/>
            <?php foreach ($consent as $channel => $consented): ?>
                <div class="admin__field">
                    <span class="admin__field-label">
                        <span><?= $escaper->escapeHtml(ucfirst($channel)) ?></span>
                    </span>
                    <div class="admin__field-control">
                        <?= $escaper->escapeHtml($consented ? __('Opted in') : __('Opted out')) ?>
                        <button type="submit" name="channel" value="<?= $escaper->escapeHtmlAttr($channel) ?>"
                                onclick="this.form.consented.value='<?= $consented ? '0' : '1' ?>'"
                                class="action-secondary">
                            <span><?= $escaper->escapeHtml($consented ? __('Opt out') : __('Opt in')) ?></span>
                        </button>
                    </div>
                </div>
            <?php endforeach; ?>
            <input type="hidden" name="consented" value=""/>
        </form>
    </div>
</div>

<div class="admin__fieldset-wrapper" style="margin-top: 20px;">
    <div class="admin__fieldset-wrapper-title">
        <strong><?= $escaper->escapeHtml(__('Data subject actions')) ?></strong>
    </div>
    <div class="admin__fieldset-wrapper-content">
        <a class="action-secondary" href="<?= $escaper->escapeUrl($block->getExportUrl()) ?>">
            <span><?= $escaper->escapeHtml(__('Export all data (JSON)')) ?></span>
        </a>
        <?php $eraseConfirm = __(
            'Permanently erase all Ordo Automation data for this customer? This cannot be undone.'
        ); ?>
        <form action="<?= $escaper->escapeUrl($block->getEraseFormAction()) ?>" method="post"
              onsubmit="return confirm('<?= $escaper->escapeJs($eraseConfirm) ?>');"
              style="display:inline-block; margin-left: 10px;">
            <?= $block->getBlockHtml('formkey') ?>
            <input type="hidden" name="customer_id" value="<?= (int) $block->getCustomerId() ?>"/>
            <button type="submit" class="action-secondary delete">
                <span><?= $escaper->escapeHtml(__('Erase all data')) ?></span>
            </button>
        </form>
    </div>
</div>
<?php endif; ?>
