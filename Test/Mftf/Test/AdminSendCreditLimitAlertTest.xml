<?xml version="1.0" encoding="UTF-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminSendCreditLimitAlertTest">
        <annotations>
            <features value="Ordo Automation"/>
            <stories value="Lifecycle emails"/>
            <title value="A real order pushes a customer over their credit limit, Cron\SendCreditLimitAlerts emails them"/>
            <description value="Model/CreditLimitCalculator derives 'used credit' from real sales_order.total_due, not a separate ledger - so this sets a real, low ordo_credit_limit on a real customer via the admin customer edit form, places a real order over that limit, then forces SendCreditLimitAlerts (real schedule 06:00 daily, see etc/crontab.xml, via CronScheduleHelper) to run and asserts the over-limit branch of credit_limit_warning.html actually rendered and was delivered."/>
            <severity value="CRITICAL"/>
            <group value="ordo_automation"/>
            <group value="lifecycle"/>
        </annotations>
        <before>
            <createData entity="Simple_US_Customer" stepKey="createCustomer"/>
            <createData entity="SimpleProduct2" stepKey="createProduct"/>
            <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>
        </before>
        <after>
            <deleteData createDataKey="createCustomer" stepKey="deleteCustomer"/>
            <deleteData createDataKey="createProduct" stepKey="deleteProduct"/>
            <actionGroup ref="AdminLogoutActionGroup" stepKey="logoutAsAdmin"/>
        </after>

        <!-- Step 1: a real, low credit limit on the real customer - SimpleProduct2's fixture
             price (123.00) comfortably exceeds this once ordered, so the alert fires as a
             genuine "over limit" case rather than the milder "approaching the warning
             threshold" one, without needing to compute an exact percentage. -->
        <amOnPage url="{{AdminEditCustomerPage.url($$createCustomer.id$$)}}" stepKey="goToCustomerEditPage"/>
        <waitForPageLoad stepKey="waitForCustomerEditPage"/>
        <waitForElementVisible selector="[name='customer[ordo_credit_limit]']" stepKey="waitForCreditLimitField"/>
        <fillField selector="[name='customer[ordo_credit_limit]']" userInput="50" stepKey="fillCreditLimit"/>
        <click selector="{{AdminCustomerMainActionsSection.saveButton}}" stepKey="saveCustomer"/>
        <see selector="{{AdminCustomerMessagesSection.successMessage}}" userInput="You saved the customer" stepKey="seeCustomerSavedMessage"/>

        <!-- Step 2: a REAL order, through REAL storefront checkout - total_due (unpaid, since
             no invoice exists yet) becomes SendCreditLimitAlerts's "used credit" the instant
             this order is placed, no separate step needed. -->
        <actionGroup ref="LoginToStorefrontActionGroup" stepKey="loginAsCustomer">
            <argument name="Customer" value="$$createCustomer$$"/>
        </actionGroup>
        <amOnPage url="$createProduct.custom_attributes[url_key]$.html" stepKey="goToProductPage"/>
        <waitForPageLoad stepKey="waitForProductPage"/>
        <actionGroup ref="AddToCartFromStorefrontProductPageActionGroup" stepKey="addProductToCart">
            <argument name="productName" value="$createProduct.name$"/>
        </actionGroup>
        <amOnPage url="checkout/cart" stepKey="goToCart"/>
        <waitForPageLoad stepKey="waitForCartPage"/>
        <actionGroup ref="PlaceOrderWithLoggedUserActionGroup" stepKey="placeRealOrder"/>

        <!-- Step 3: force SendCreditLimitAlerts to run now (its real schedule is 06:00 daily -
             see etc/crontab.xml - which a CI run can't wait out). -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\CronScheduleHelper" method="scheduleJobNow" stepKey="scheduleSendCreditLimitAlertsJob">
            <argument name="jobCode">ordo_automation_send_credit_limit_alerts</argument>
        </helper>
        <magentoCLI command="cron:run --group=default" stepKey="runSendCreditLimitAlertsCron"/>

        <!-- Step 4: the real, merchant-visible output only crossing a real credit limit could
             have produced - credit_limit_warning.html's {{depend is_over_limit}} branch, not
             the milder "approaching the limit" one, since the order comfortably exceeds it. -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\MailHogHelper" method="seeTextInLatestEmail" stepKey="seeOverLimitCopyInEmail">
            <argument name="expectedText">Your account has gone over its credit limit</argument>
            <argument name="toAddress">$createCustomer.email$</argument>
        </helper>
    </test>
</tests>
