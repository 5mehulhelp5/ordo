<?xml version="1.0" encoding="UTF-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminReorderCycleMassDeleteTest">
        <annotations>
            <features value="Ordo Automation"/>
            <stories value="Reorder cycles"/>
            <title value="The Reorder Cycles grid's mass-delete removes a real, genuinely-detected cycle row"/>
            <description value="Closes SCENARIOS.md §8's last reorder-cycle gap. Same real three-order/backdate/cron setup as AdminReorderCycleAndReminderTest (Cron\CalculateReorderCycle requires >= 3 real orders with a real interval, which OrderBackdateHelper produces via a 30/20/10-day spacing) - a real ordo_reorder_cycle row genuinely exists first, then the grid's own row checkbox (located by this customer's real email) is selected and the mass-delete action is applied and confirmed through Magento's real confirm modal. The row being genuinely gone afterward (Controller\Adminhtml\ReorderCycle\MassDelete just clears the prediction early - the same or a fresh row is recomputed on the next cron tick from real order history, see that controller's own docblock) is proof only a real mass-delete against this real row could have produced."/>
            <severity value="MINOR"/>
            <group value="ordo_automation"/>
            <group value="lifecycle"/>
        </annotations>
        <before>
            <createData entity="Simple_US_Customer" stepKey="createCustomer"/>
            <createData entity="SimpleProduct2" stepKey="createProduct"/>
            <magentoCLI command="config:set ordo_automation/reorder/enabled 1" stepKey="enableReorder"/>
        </before>
        <after>
            <magentoCLI command="config:set ordo_automation/reorder/enabled 0" stepKey="disableReorder"/>
            <deleteData createDataKey="createCustomer" stepKey="deleteCustomer"/>
            <deleteData createDataKey="createProduct" stepKey="deleteProduct"/>
        </after>

        <!-- Step 1: three REAL orders of the same SKU, through REAL storefront checkout - same
             MIN_ORDERS_TO_DETECT_PATTERN=3 requirement as AdminReorderCycleAndReminderTest. -->
        <actionGroup ref="LoginToStorefrontActionGroup" stepKey="loginAsCustomer">
            <argument name="Customer" value="$$createCustomer$$"/>
        </actionGroup>

        <amOnPage url="$createProduct.custom_attributes[url_key]$.html" stepKey="goToProductPage1"/>
        <waitForPageLoad stepKey="waitForProductPage1"/>
        <actionGroup ref="AddToCartFromStorefrontProductPageActionGroup" stepKey="addProductToCart1">
            <argument name="productName" value="$createProduct.name$"/>
        </actionGroup>
        <amOnPage url="checkout/cart" stepKey="goToCart1"/>
        <waitForPageLoad stepKey="waitForCartPage1"/>
        <actionGroup ref="PlaceOrderWithLoggedUserActionGroup" stepKey="placeOrder1"/>

        <amOnPage url="$createProduct.custom_attributes[url_key]$.html" stepKey="goToProductPage2"/>
        <waitForPageLoad stepKey="waitForProductPage2"/>
        <actionGroup ref="AddToCartFromStorefrontProductPageActionGroup" stepKey="addProductToCart2">
            <argument name="productName" value="$createProduct.name$"/>
        </actionGroup>
        <amOnPage url="checkout/cart" stepKey="goToCart2"/>
        <waitForPageLoad stepKey="waitForCartPage2"/>
        <actionGroup ref="PlaceOrderWithLoggedUserActionGroup" stepKey="placeOrder2"/>

        <amOnPage url="$createProduct.custom_attributes[url_key]$.html" stepKey="goToProductPage3"/>
        <waitForPageLoad stepKey="waitForProductPage3"/>
        <actionGroup ref="AddToCartFromStorefrontProductPageActionGroup" stepKey="addProductToCart3">
            <argument name="productName" value="$createProduct.name$"/>
        </actionGroup>
        <amOnPage url="checkout/cart" stepKey="goToCart3"/>
        <waitForPageLoad stepKey="waitForCartPage3"/>
        <actionGroup ref="PlaceOrderWithLoggedUserActionGroup" stepKey="placeOrder3"/>

        <!-- Step 2: a real, even 10-day spacing (30/20/10 days ago), then force
             CalculateReorderCycle to run now (real nightly schedule, see etc/crontab.xml) - a
             real row now genuinely exists for this customer/SKU. -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\OrderBackdateHelper" method="backdateRecentOrders" stepKey="backdateOrders">
            <argument name="daysAgoCsv">30,20,10</argument>
            <argument name="customerId">$createCustomer.id$</argument>
        </helper>
        <helper class="\Ordo\Automation\Test\Mftf\Helper\CronScheduleHelper" method="scheduleJobNow" stepKey="scheduleCalculateReorderCycleJob">
            <argument name="jobCode">ordo_automation_calculate_reorder_cycle</argument>
        </helper>
        <magentoCLI command="cron:run --group=default" stepKey="runCalculateReorderCycleCron"/>

        <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>

        <!-- Step 3: the Reorder Cycles grid - select this customer's real row (located by
             email, not row position, since other customers/orders can exist in this same shared
             CI job's DB), open the mass-action "Actions" dropdown, choose "Delete", and accept
             Magento's real confirm modal. -->
        <amOnPage url="admin/ordo/reordercycle/index" stepKey="goToReorderCycleGrid"/>
        <waitForPageLoad stepKey="waitForReorderCycleGrid"/>
        <waitForElementVisible selector="{{AdminDataGridTableSection.rowTemplate($createCustomer.email$)}}" stepKey="waitForCustomerRow"/>
        <click selector="//tr[td[*[contains(.,normalize-space('$createCustomer.email$'))]]]//input[@type='checkbox']" stepKey="clickCustomerRowCheckbox"/>
        <waitForElementVisible selector="button.action-select" stepKey="waitForActionsButton"/>
        <click selector="button.action-select" stepKey="clickActionsButton"/>
        <waitForElementVisible selector="//li[contains(., 'Delete')]" stepKey="waitForDeleteMenuItem"/>
        <click selector="//li[contains(., 'Delete')]" stepKey="clickDeleteMenuItem"/>
        <waitForElementVisible selector=".modal-popup.confirm .action-primary" stepKey="waitForConfirmModal"/>
        <click selector=".modal-popup.confirm .action-primary" stepKey="clickConfirmDelete"/>
        <waitForPageLoad stepKey="waitForMassActionRedirect"/>
        <see selector=".message-success" userInput="have been deleted" stepKey="seeMassActionSuccessMessage"/>

        <!-- Step 4: the real, database-observable proof only a genuine mass-delete against this
             exact row could have produced. -->
        <dontSeeElement selector="{{AdminDataGridTableSection.rowTemplate($createCustomer.email$)}}" stepKey="dontSeeCustomerRowAfterDelete"/>

        <actionGroup ref="AdminLogoutActionGroup" stepKey="logoutAsAdmin"/>
    </test>
</tests>
