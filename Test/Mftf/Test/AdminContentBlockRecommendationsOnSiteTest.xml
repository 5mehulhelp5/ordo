<?xml version="1.0" encoding="UTF-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminContentBlockRecommendationsOnSiteTest">
        <annotations>
            <features value="Ordo Automation"/>
            <stories value="Dynamic content blocks"/>
            <title value="A 'recommendations' content block renders on-site, embedded in a real CMS page, for an anonymous visitor"/>
            <description value="Closes ROADMAP.md's 'On-site product recommendation blocks' gap: unlike every other content-block type this suite already covers (rss/product_feed/snippet), which only ever reach a customer via a campaign's send_email action, this proves Block/Frontend/ContentBlock/Render.php - a real storefront Block resolving a content block by its human-authored identifier and calling the same ProducerPool a campaign email uses, embedded via a real CMS page's own Layout Update XML (the standard, always-available 'Content &gt; Design' field every CMS page has, not something invented for this test). The {{widget}} CMS directive (etc/widget.xml registers this same Render block as 'ordo_content_block') was this test's first, now-abandoned mechanism: two real CI runs proved it resolves to nothing (no PHP error, Render never even instantiated) regardless of single- or double-escaped backslashes in the class name, root cause still unconfirmed - Layout Update XML sidesteps whatever that is entirely, using plain, well-established block-in-layout instantiation instead. etc/widget.xml stays registered as a documented, currently-unverified alternative. Switching to Layout Update XML then failed a SECOND time for an unrelated reason, root-caused by downloading that CI run's own failure screenshot: the page rendered with ONLY its default sample content, no trace of the block at all - Magento_Cms's own CreateCMSPage MFTF operation (module-cms/Test/Mftf/Metadata/CmsMeta.xml) declares a closed field whitelist for the real /V1/cmsPage request body that never included layout_update_xml, so MFTF was silently dropping this entity's own data for that field before it ever reached the API - not a Magento bug, an MFTF metadata gap. Fixed by Test/Mftf/Metadata/CmsPageLayoutUpdateXmlMeta.xml, which extends that same operation (by name) with the one missing field, same as any module extending a built-in MFTF operation. A real order (by a throwaway seed customer) makes SimpleProduct2 the store's only best-seller, so ProductRecommender::getRecommendedSkus()'s own store-wide-best-sellers fallback surfaces it even for a completely anonymous, never-logged-in visitor loading a real CMS page afterward - proving the on-site path works independent of any campaign, dispatch, or login."/>
            <severity value="MAJOR"/>
            <group value="ordo_automation"/>
            <group value="campaign2"/>
        </annotations>
        <before>
            <createData entity="Simple_US_Customer" stepKey="createSeedCustomer"/>
            <createData entity="SimpleProduct2" stepKey="createProduct"/>
            <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>
        </before>
        <after>
            <deleteData createDataKey="createSeedCustomer" stepKey="deleteSeedCustomer"/>
            <deleteData createDataKey="createProduct" stepKey="deleteProduct"/>
            <deleteData createDataKey="createCmsPage" stepKey="deleteCmsPage"/>
            <actionGroup ref="AdminLogoutActionGroup" stepKey="logoutAsAdmin"/>
        </after>

        <!-- Step 1: the "recommendations" content block - count deliberately left at its own
             default (4), same reasoning as every other content-block test in this suite: this
             test doesn't assert on the exact count, only that the one real best-selling product
             shows up. -->
        <amOnPage url="admin/ordo/contentblock/new" stepKey="goToNewContentBlockPage"/>
        <waitForPageLoad stepKey="waitForNewContentBlockPage"/>
        <waitForElementVisible selector="[name='identifier']" stepKey="waitForIdentifierField"/>
        <fillField selector="[name='identifier']" userInput="e2e_onsite_recommendations_block" stepKey="fillIdentifier"/>
        <fillField selector="[name='name']" userInput="E2E On-Site Recommendations Block" stepKey="fillName"/>
        <selectOption selector="[name='type']" userInput="recommendations" stepKey="selectRecommendationsType"/>

        <click selector="//button[contains(., 'Save &amp; Continue Edit')]" stepKey="clickSaveContentBlock"/>
        <waitForPageLoad stepKey="waitForContentBlockSave"/>
        <see selector=".message-success" userInput="The content block has been saved." stepKey="seeContentBlockSuccessMessage"/>
        <grabFromCurrentUrl regex="/entity_id\/(\d+)/" stepKey="grabContentBlockId"/>

        <!-- Step 2: a real CMS page embedding the block via its own Layout Update XML - the
             standard "Content > Design > Layout Update XML" field every CMS page has, validated
             by the real Magento\Framework\View\Model\Layout\Update\Validator against
             page_layout.xsd (which is what makes <referenceContainer>/<block> valid here), not
             something invented for this test. Chosen over the {{widget}} directive after two
             real CI failures proved that mechanism resolves to nothing here - see this test's
             own description for the full story. -->
        <createData entity="_defaultCmsPage" stepKey="createCmsPage">
            <field key="identifier">e2e-onsite-recommendations-page</field>
            <field key="layout_update_xml">&lt;referenceContainer name="content"&gt;&lt;block class="Ordo\Automation\Block\Frontend\ContentBlock\Render" name="e2e.ordo.recommendations"&gt;&lt;arguments&gt;&lt;argument name="identifier" xsi:type="string"&gt;e2e_onsite_recommendations_block&lt;/argument&gt;&lt;/arguments&gt;&lt;/block&gt;&lt;/referenceContainer&gt;</field>
        </createData>

        <!-- Step 3: a REAL order, through REAL storefront checkout, by a throwaway seed
             customer - this is what makes SimpleProduct2 the store's only best-seller
             (ProductRecommender::rankedBestSellerSkus()), independent of any campaign or
             dispatch. -->
        <actionGroup ref="LoginToStorefrontActionGroup" stepKey="loginAsSeedCustomer">
            <argument name="Customer" value="$$createSeedCustomer$$"/>
        </actionGroup>
        <amOnPage url="$createProduct.custom_attributes[url_key]$.html" stepKey="goToProductPage"/>
        <waitForPageLoad stepKey="waitForProductPage"/>
        <actionGroup ref="AddToCartFromStorefrontProductPageActionGroup" stepKey="addProductToCart">
            <argument name="productName" value="$createProduct.name$"/>
        </actionGroup>
        <amOnPage url="checkout/cart" stepKey="goToCart"/>
        <waitForPageLoad stepKey="waitForCartPage"/>
        <actionGroup ref="PlaceOrderWithLoggedUserActionGroup" stepKey="placeRealOrder"/>

        <!-- Step 4: log back out - the actual proof this test is after is that the on-site
             block works for a completely anonymous visitor, not just a logged-in one. -->
        <actionGroup ref="StorefrontCustomerLogoutActionGroup" stepKey="logoutSeedCustomer"/>

        <!-- Step 5: the actual proof - the real best-selling product's own name, rendered by
             Block\Frontend\ContentBlock\Render on a real CMS page, for a visitor who never
             logged in and never interacted with any campaign. -->
        <amOnPage url="e2e-onsite-recommendations-page" stepKey="goToCmsPage"/>
        <waitForPageLoad stepKey="waitForCmsPage"/>
        <see selector=".recommended-products" userInput="$createProduct.name$" stepKey="seeRecommendedProductOnPage"/>

        <!-- Cleanup: no <deleteData> equivalent for this REST-less entity - delete it directly
             through the real admin UI instead, same reasoning as every other content-block test
             in this suite. -->
        <amOnPage url="admin/ordo/contentblock/delete/entity_id/{$grabContentBlockId}/" stepKey="deleteContentBlock"/>
        <waitForPageLoad stepKey="waitForDeleteContentBlock"/>
    </test>
</tests>
