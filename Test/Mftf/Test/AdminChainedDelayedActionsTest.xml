<?xml version="1.0" encoding="UTF-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminChainedDelayedActionsTest">
        <annotations>
            <features value="Ordo Automation"/>
            <stories value="Campaign engine"/>
            <title value="A campaign with two separate delayed actions pauses, resumes, then pauses again"/>
            <description value="AdminCampaignDelayedActionTest already proves a single delay_minutes pause/resume; this proves the CHAINED case (SCENARIOS.md §1d): action 2 delays, gets resumed, then action 3 - on the very same campaign - ALSO delays and needs its own separate resume, rather than the chain running straight through once the first delay clears. Uses CronScheduleHelper (forcing Cron\RunScheduledCampaignActions to run now, twice, once per delay) instead of AdminCampaignDelayedActionTest's real 65s+5.5min wait loop - proving the same mechanism without paying that wall-clock cost twice over."/>
            <severity value="CRITICAL"/>
            <group value="ordo_automation"/>
            <group value="dashboard"/>
        </annotations>
        <before>
            <createData entity="Simple_US_Customer" stepKey="createCustomer"/>
            <createData entity="SimpleProduct2" stepKey="createProduct"/>
            <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>
        </before>
        <after>
            <deleteData createDataKey="createCustomer" stepKey="deleteCustomer"/>
            <deleteData createDataKey="createProduct" stepKey="deleteProduct"/>
            <actionGroup ref="AdminLogoutActionGroup" stepKey="logoutAsAdmin"/>
        </after>

        <!-- Step 1: three add_tag actions on one campaign - immediate, then two each delayed.
             The exact delay_minutes value doesn't matter (CronScheduleHelper forces the resuming
             cron to run regardless of real elapsed time, same technique as the lifecycle-group
             tests), only that it's > 0 so CampaignDispatcher::runActionsFrom() actually pauses. -->
        <amOnPage url="admin/ordo/campaign/new" stepKey="goToNewCampaignPage"/>
        <waitForPageLoad stepKey="waitForNewCampaignPage"/>
        <waitForElementVisible selector="[name='name']" stepKey="waitForNameField"/>
        <fillField selector="[name='name']" userInput="Chained Delayed Actions Campaign" stepKey="fillName"/>

        <waitForElementVisible selector="//*[contains(text(), 'Add Trigger')]" stepKey="waitForAddTriggerButton"/>
        <click selector="//*[contains(text(), 'Add Trigger')]" stepKey="addTriggerRow"/>
        <waitForElementVisible selector="[name='triggers[triggers][0][trigger_event]']" stepKey="waitForTriggerRow"/>
        <selectOption selector="[name='triggers[triggers][0][trigger_event]']" userInput="order_placed" stepKey="selectTriggerEvent"/>

        <click selector="//*[contains(text(), 'Add Action')]" stepKey="addActionRow0"/>
        <waitForElementVisible selector="[name='actions[actions][0][type]']" stepKey="waitForActionRow0"/>
        <selectOption selector="[name='actions[actions][0][type]']" userInput="add_tag" stepKey="selectActionType0"/>
        <waitForElementVisible selector="[name='actions[actions][0][tag]']" stepKey="waitForTagField0"/>
        <fillField selector="[name='actions[actions][0][tag]']" userInput="chain-start" stepKey="fillTag0"/>
        <fillField selector="[name='actions[actions][0][delay_minutes]']" userInput="0" stepKey="fillDelayMinutes0"/>

        <click selector="//*[contains(text(), 'Add Action')]" stepKey="addActionRow1"/>
        <waitForElementVisible selector="[name='actions[actions][1][type]']" stepKey="waitForActionRow1"/>
        <selectOption selector="[name='actions[actions][1][type]']" userInput="add_tag" stepKey="selectActionType1"/>
        <waitForElementVisible selector="[name='actions[actions][1][tag]']" stepKey="waitForTagField1"/>
        <fillField selector="[name='actions[actions][1][tag]']" userInput="chain-middle" stepKey="fillTag1"/>
        <fillField selector="[name='actions[actions][1][delay_minutes]']" userInput="1440" stepKey="fillDelayMinutes1"/>

        <click selector="//*[contains(text(), 'Add Action')]" stepKey="addActionRow2"/>
        <waitForElementVisible selector="[name='actions[actions][2][type]']" stepKey="waitForActionRow2"/>
        <selectOption selector="[name='actions[actions][2][type]']" userInput="add_tag" stepKey="selectActionType2"/>
        <waitForElementVisible selector="[name='actions[actions][2][tag]']" stepKey="waitForTagField2"/>
        <fillField selector="[name='actions[actions][2][tag]']" userInput="chain-end" stepKey="fillTag2"/>
        <fillField selector="[name='actions[actions][2][delay_minutes]']" userInput="1440" stepKey="fillDelayMinutes2"/>

        <executeJS function="document.evaluate(&quot;//input[@name='enabled']/following-sibling::label&quot;, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue.click();" stepKey="enableCampaign"/>
        <click selector="//button[contains(., 'Save &amp; Continue Edit')]" stepKey="clickSaveAndContinue"/>
        <waitForPageLoad stepKey="waitForSave"/>
        <see selector=".message-success" userInput="The campaign has been saved." stepKey="seeSuccessMessage"/>
        <grabFromCurrentUrl regex="/entity_id\/(\d+)/" stepKey="grabCampaignId"/>

        <!-- Step 2: a REAL order dispatches the chain. Only chain-start must apply so far - the
             first delay must have genuinely paused the rest. -->
        <actionGroup ref="LoginToStorefrontActionGroup" stepKey="loginAsCustomer">
            <argument name="Customer" value="$$createCustomer$$"/>
        </actionGroup>
        <amOnPage url="$createProduct.custom_attributes[url_key]$.html" stepKey="goToProductPage"/>
        <waitForPageLoad stepKey="waitForProductPage"/>
        <actionGroup ref="AddToCartFromStorefrontProductPageActionGroup" stepKey="addProductToCart">
            <argument name="productName" value="$createProduct.name$"/>
        </actionGroup>
        <amOnPage url="checkout/cart" stepKey="goToCart"/>
        <waitForPageLoad stepKey="waitForCartPage"/>
        <actionGroup ref="PlaceOrderWithLoggedUserActionGroup" stepKey="placeRealOrder"/>
        <magentoCLI command="queue:consumers:start ordo.automation.campaign.dispatch --max-messages=50" stepKey="runCampaignDispatchConsumer"/>

        <helper class="\Ordo\Automation\Test\Mftf\Helper\VisitorEventHelper" method="assertCustomerTagAddedByEmail" stepKey="assertChainStartApplied">
            <argument name="email">$createCustomer.email$</argument>
            <argument name="tag">chain-start</argument>
        </helper>
        <helper class="\Ordo\Automation\Test\Mftf\Helper\VisitorEventHelper" method="assertCustomerTagNotAddedByEmail" stepKey="assertChainMiddleNotYetApplied">
            <argument name="email">$createCustomer.email$</argument>
            <argument name="tag">chain-middle</argument>
        </helper>

        <!-- Step 3: force RunScheduledCampaignActions to run now (real schedule every 5 minutes,
             see etc/crontab.xml) - resumes the FIRST delayed action (chain-middle), then must
             pause AGAIN at the second delay, not run chain-end in the same pass. Forcing the
             JOB alone isn't enough: CampaignDispatcher wrote the scheduled row's run_at as
             NOW() + delay_minutes (24h away, given delay_minutes=1440 above), so
             backdateMostRecentScheduledAction() also backdates the DATA the job's own
             addDueFilter() checks - both are real, separate "is this due" checks. -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\CronScheduleHelper" method="backdateMostRecentScheduledAction" stepKey="backdateFirstScheduledAction">
            <argument name="campaignId">{$grabCampaignId}</argument>
        </helper>
        <helper class="\Ordo\Automation\Test\Mftf\Helper\CronScheduleHelper" method="scheduleJobNow" stepKey="scheduleFirstResumeJob">
            <argument name="jobCode">ordo_automation_run_scheduled_campaign_actions</argument>
        </helper>
        <magentoCLI command="cron:run --group=default" stepKey="runFirstResumeCron"/>

        <helper class="\Ordo\Automation\Test\Mftf\Helper\VisitorEventHelper" method="assertCustomerTagAddedByEmail" stepKey="assertChainMiddleApplied">
            <argument name="email">$createCustomer.email$</argument>
            <argument name="tag">chain-middle</argument>
        </helper>
        <helper class="\Ordo\Automation\Test\Mftf\Helper\VisitorEventHelper" method="assertCustomerTagNotAddedByEmail" stepKey="assertChainEndNotYetApplied">
            <argument name="email">$createCustomer.email$</argument>
            <argument name="tag">chain-end</argument>
        </helper>

        <!-- Step 4: force the cron a second time - a NEW ordo_campaign_scheduled_action row was
             written when chain-middle's own resume hit the second delay, so this must be a
             genuinely separate forced run, not a leftover from step 3, and needs its own
             backdate (this new row also got a real run_at = NOW() + 1440 minutes). -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\CronScheduleHelper" method="backdateMostRecentScheduledAction" stepKey="backdateSecondScheduledAction">
            <argument name="campaignId">{$grabCampaignId}</argument>
        </helper>
        <helper class="\Ordo\Automation\Test\Mftf\Helper\CronScheduleHelper" method="scheduleJobNow" stepKey="scheduleSecondResumeJob">
            <argument name="jobCode">ordo_automation_run_scheduled_campaign_actions</argument>
        </helper>
        <magentoCLI command="cron:run --group=default" stepKey="runSecondResumeCron"/>

        <helper class="\Ordo\Automation\Test\Mftf\Helper\VisitorEventHelper" method="assertCustomerTagAddedByEmail" stepKey="assertChainEndApplied">
            <argument name="email">$createCustomer.email$</argument>
            <argument name="tag">chain-end</argument>
        </helper>
    </test>
</tests>
