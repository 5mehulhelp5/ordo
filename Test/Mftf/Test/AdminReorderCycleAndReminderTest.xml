<?xml version="1.0" encoding="UTF-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminReorderCycleAndReminderTest">
        <annotations>
            <features value="Ordo Automation"/>
            <stories value="Reorder cycles"/>
            <title value="Cron\CalculateReorderCycle detects a real recurring purchase from order history, Cron\SendReorderReminders then emails the customer"/>
            <description value="These two crons are as tightly coupled as TagInactiveCustomers/SendWinBackEmails - CalculateReorderCycle 'never emails anyone by itself' (see its own class doc), it only writes the ordo_reorder_cycle row SendReorderReminders reads - so one test covers both. CalculateReorderCycle requires a real interval between orders (it explicitly skips same-day repeats), which three real storefront checkouts placed back to back can't produce on their own - OrderBackdateHelper backdates them to 30/20/10 days ago (a real, even 10-day spacing) directly via the DB, since no MFTF-reachable UI/API sets sales_order.created_at. ordo_automation/reorder/lead_days is set to 0 so the predicted next-order date (10 days ago + the detected 10-day average = today) is already due; CronScheduleHelper forces both crons to run now instead of waiting out their real nightly schedules."/>
            <severity value="CRITICAL"/>
            <group value="ordo_automation"/>
            <group value="lifecycle"/>
        </annotations>
        <before>
            <createData entity="Simple_US_Customer" stepKey="createCustomer"/>
            <createData entity="SimpleProduct2" stepKey="createProduct"/>
            <!-- Off by default (Helper/Config.php's isSetFlag-backed getter) and the lead time
                 is cut from the real default (2 days) to 0, so a cycle due "today" already
                 qualifies. Both restored in <after> so they don't linger for whatever other
                 campaign-group test runs next in this same install. -->
            <magentoCLI command="config:set ordo_automation/reorder/enabled 1" stepKey="enableReorder"/>
            <magentoCLI command="config:set ordo_automation/reorder/lead_days 0" stepKey="setLeadDaysToZero"/>
        </before>
        <after>
            <magentoCLI command="config:set ordo_automation/reorder/enabled 0" stepKey="disableReorder"/>
            <magentoCLI command="config:set ordo_automation/reorder/lead_days 2" stepKey="restoreLeadDaysDefault"/>
            <deleteData createDataKey="createCustomer" stepKey="deleteCustomer"/>
            <deleteData createDataKey="createProduct" stepKey="deleteProduct"/>
        </after>

        <!-- Step 1: three REAL orders of the same SKU, through REAL storefront checkout, as the
             REAL customer created above - CalculateReorderCycle's SQL must find this pattern
             entirely on its own (customer_id + sku grouping, >= 3 orders), not a synthetic
             fixture. MIN_ORDERS_TO_DETECT_PATTERN is 3, so exactly three, no more. -->
        <actionGroup ref="LoginToStorefrontActionGroup" stepKey="loginAsCustomer">
            <argument name="Customer" value="$$createCustomer$$"/>
        </actionGroup>

        <amOnPage url="$createProduct.custom_attributes[url_key]$.html" stepKey="goToProductPage1"/>
        <waitForPageLoad stepKey="waitForProductPage1"/>
        <actionGroup ref="AddToCartFromStorefrontProductPageActionGroup" stepKey="addProductToCart1">
            <argument name="productName" value="$createProduct.name$"/>
        </actionGroup>
        <amOnPage url="checkout/cart" stepKey="goToCart1"/>
        <waitForPageLoad stepKey="waitForCartPage1"/>
        <actionGroup ref="PlaceOrderWithLoggedUserActionGroup" stepKey="placeOrder1"/>

        <amOnPage url="$createProduct.custom_attributes[url_key]$.html" stepKey="goToProductPage2"/>
        <waitForPageLoad stepKey="waitForProductPage2"/>
        <actionGroup ref="AddToCartFromStorefrontProductPageActionGroup" stepKey="addProductToCart2">
            <argument name="productName" value="$createProduct.name$"/>
        </actionGroup>
        <amOnPage url="checkout/cart" stepKey="goToCart2"/>
        <waitForPageLoad stepKey="waitForCartPage2"/>
        <actionGroup ref="PlaceOrderWithLoggedUserActionGroup" stepKey="placeOrder2"/>

        <amOnPage url="$createProduct.custom_attributes[url_key]$.html" stepKey="goToProductPage3"/>
        <waitForPageLoad stepKey="waitForProductPage3"/>
        <actionGroup ref="AddToCartFromStorefrontProductPageActionGroup" stepKey="addProductToCart3">
            <argument name="productName" value="$createProduct.name$"/>
        </actionGroup>
        <amOnPage url="checkout/cart" stepKey="goToCart3"/>
        <waitForPageLoad stepKey="waitForCartPage3"/>
        <actionGroup ref="PlaceOrderWithLoggedUserActionGroup" stepKey="placeOrder3"/>

        <!-- Step 2: a real, even 10-day spacing (30/20/10 days ago) - avg_interval_days must
             come out to exactly 10, and the predicted next_expected_date (10 days ago + 10 =
             today) must already be due, not a few days in the future. -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\OrderBackdateHelper" method="backdateRecentOrders" stepKey="backdateOrders">
            <argument name="daysAgoCsv">30,20,10</argument>
            <argument name="customerId">$createCustomer.id$</argument>
        </helper>

        <!-- Step 3: force CalculateReorderCycle to run now (real schedule 02:00 daily, see
             etc/crontab.xml) - it must detect the pattern and write the ordo_reorder_cycle row
             SendReorderReminders depends on. -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\CronScheduleHelper" method="scheduleJobNow" stepKey="scheduleCalculateReorderCycleJob">
            <argument name="jobCode">ordo_automation_calculate_reorder_cycle</argument>
        </helper>
        <magentoCLI command="cron:run --group=default" stepKey="runCalculateReorderCycleCron"/>

        <!-- Step 4: force SendReorderReminders to run now (real schedule 07:00 daily) - it must
             find the cycle just written, see its next_expected_date is already due, and email
             the customer. -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\CronScheduleHelper" method="scheduleJobNow" stepKey="scheduleSendReorderRemindersJob">
            <argument name="jobCode">ordo_automation_send_reorder_reminders</argument>
        </helper>
        <magentoCLI command="cron:run --group=default" stepKey="runSendReorderRemindersCron"/>

        <!-- Step 5: the real, merchant-visible output only a genuinely-detected, genuinely-due
             reorder cycle could have produced - reorder_reminder.html rendered with this
             product's real SKU. -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\MailHogHelper" method="seeTextInLatestEmail" stepKey="seeReorderCopyInEmail">
            <argument name="expectedText">You usually order</argument>
            <argument name="toAddress">$createCustomer.email$</argument>
        </helper>
        <helper class="\Ordo\Automation\Test\Mftf\Helper\MailHogHelper" method="seeTextInLatestEmail" stepKey="seeSkuInEmail">
            <argument name="expectedText">$createProduct.sku$</argument>
            <argument name="toAddress">$createCustomer.email$</argument>
        </helper>
    </test>
</tests>
