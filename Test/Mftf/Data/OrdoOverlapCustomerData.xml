<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="urn:magento:mftf:DataGenerator/etc/dataProfileSchema.xsd">
    <!-- Magento_Customer's own CustomerEntityOne has no second sibling entity - AdminSegmentOverlapPageTest
         needs two genuinely distinct real registrations in one test (SignUpNewUserFromStorefrontActionGroup
         reads {{Customer.email}} fresh per invocation, but a SECOND invocation against the SAME
         entity would resolve to the SAME already-registered unique email within one test run,
         failing the second signup as a duplicate account) - this is that second, independently
         unique entity. -->
    <entity name="OrdoOverlapCustomerTwo" type="customer">
        <data key="group_id">1</data>
        <data key="default_billing">true</data>
        <data key="default_shipping">true</data>
        <data key="email" unique="prefix">overlap.two@example.com</data>
        <data key="firstname">Overlap</data>
        <data key="lastname">Two</data>
        <data key="fullname">Overlap Two</data>
        <data key="password">pwdTest123!</data>
        <data key="store_id">0</data>
        <data key="website_id">0</data>
        <data key="group">General</data>
    </entity>
</entities>
